HOME_NAME=Magalang, Pampanga
HOME_LAT=15.2147
HOME_LNG=120.6586
RADIUS_KM=25
# carousell_apify = cloud scouting via Apify (recommended). carousell = your own Chrome. Add more: carousell_apify,lazada
# Add carousell_apify only if your Apify plan includes residential proxies (it returns 0 results without them)
SOURCES=facebook_marketplace,facebook_groups
APIFY_TOKEN=
APIFY_MAX_ITEMS=10
# Facebook Marketplace: copy the place part of your Marketplace URL (facebook.com/marketplace/<THIS>/...)
# Pause Apify scans when this share of the monthly budget is used
APIFY_BUDGET_USD=5
APIFY_STOP_AT_PCT=90
# Public Facebook group links, comma separated (private groups cannot be read)
FB_GROUPS=
GROUP_MAX_POSTS=10
GROUP_HOURS=8
QUERIES_PER_RUN=3
DETAIL_TOP_N=3
TRAVEL_PESO_PER_KM=10
FB_LOCATION=
FB_RADIUS_KM=25
FB_MAX_ITEMS=8
# Your own priority searches, run every scan (optional). The rest come from the built-in tech catalog, a few per run.
WATCH=
ALERT_MIN_SCORE=60
INTERVAL_MIN=30
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# AI keys are optional and all free. Set one or more; they are tried in this order.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Alerts (set any; all optional and free). Telegram is no longer needed.
DISCORD_WEBHOOK_URL=
NTFY_TOPIC=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- v5 ---
# Zones: near and nearby limits in km. Far listings are kept, just labeled. (Your location is saved in the dashboard's Settings.)
NEAR_KM=15
FAR_KM=50
# Profit math: 5% haggling + 3% platform, payment and handling costs. Both are also editable in the dashboard.
HAGGLE_PCT=5
FEE_PCT=3
# Full details (description, specs, seller, coordinates) for this many new listings per scan, best price first
DETAIL_MAX=10
# Photo check per scan (Gemini). GROQ_VISION_MODEL / OPENROUTER_VISION_MODEL enable those providers for photos.
VISION_TOP_N=3
# Place lookups per scan for names the built-in Philippines list does not know (OpenStreetMap Nominatim, 1 per second)
GEOCODE_CAP=12
# Group finder: look for new public groups every N days, check this many candidates per scan, scan at most this many groups
DISCOVER_DAYS=7
DISCOVER_EVAL=2
MAX_GROUPS=4
